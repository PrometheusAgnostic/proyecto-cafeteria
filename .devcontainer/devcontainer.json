{
  "name": "Cafeteria Development",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "runServices": ["postgres"],
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "none"
    }
  },
  "forwardPorts": [8080, 5173, 5432],
  "portsAttributes": {
    "8080": { "label": "Spring Boot API" },
    "5173": { "label": "Vue development server" },
    "5432": { "label": "PostgreSQL" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "Vue.volar",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "git config --global --add safe.directory /workspace && mvn -f backend/pom.xml dependency:go-offline && npm --prefix frontend install"
}